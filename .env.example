# Postgres connection (Vercel Postgres). Pull from `vercel env pull .env.local`
# or set manually for local dev against any Postgres instance.
POSTGRES_URL="postgres://user:password@host:5432/dbname"

# Session signing secret (any long random string). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Base URL of the Flask + ngrok prediction API, e.g. https://xxxx.ngrok-free.app
# Updated by the student every time the Colab notebook / ngrok tunnel restarts.
PREDICTION_API_BASE_URL="https://your-ngrok-url.ngrok-free.app"

# When true, /api/predict returns a deterministic simulated prediction instead
# of calling PREDICTION_API_BASE_URL. Useful when the Colab notebook is offline
# (e.g. during a viva). Clearly labeled "Demo data" in the UI.
DEMO_MODE="true"
